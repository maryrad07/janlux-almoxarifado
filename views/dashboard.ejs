<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container-fluid">
  <!-- Top Welcome Banner & Date -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
    <div>
      <h3 class="fw-bold mb-1" style="color: var(--janlux-primary);">Painel de Controle Operacional</h3>
      <div class="text-muted small">
        <i class="bi bi-building me-1"></i> JANLUX ELÉTRICOS LTDA. &bull; Bem-vindo(a), <strong><%= currentUser.nome %></strong>
      </div>
    </div>
    <div class="mt-3 mt-md-0 d-flex gap-2">
      <a href="/expedicoes/nova" class="btn btn-janlux btn-sm">
        <i class="bi bi-plus-circle me-1"></i> Nova Expedição
      </a>
      <a href="/coletas/nova" class="btn btn-success btn-sm">
        <i class="bi bi-truck me-1"></i> Registrar Coleta
      </a>
      <a href="/almoxarifado" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-box-arrow-down-right me-1"></i> Movimentar Embalagens
      </a>
    </div>
  </div>

  <!-- Alertas de Embalagens e Divergências (se houver) -->
  <% if (embalagensAlertas.length > 0) { %>
    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
      <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
      <div class="flex-grow-1">
        <strong>Atenção ao Estoque de Embalagens!</strong> Existem <strong><%= embalagensAlertas.length %></strong> modelo(s) de embalagem abaixo do estoque mínimo:
        <ul class="mb-0 mt-1 small">
          <% embalagensAlertas.forEach(a => { %>
            <li><%= a.descricao %> (Cód: <%= a.codigo %>) &mdash; Saldo atual: <strong><%= a.saldo %> un</strong> (Mínimo: <%= a.minimo %> un)</li>
          <% }) %>
        </ul>
      </div>
      <a href="/almoxarifado" class="btn btn-sm btn-outline-dark ms-3">Regularizar Estoque</a>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- Grid de Indicadores Principais (Clicáveis) -->
  <div class="row g-3 mb-4">
    <!-- 1. Expedições Hoje -->
    <div class="col-6 col-md-4 col-xl-2">
      <a href="/expedicoes" class="text-decoration-none">
        <div class="card card-janlux card-stat p-3 h-100" style="border-left-color: #0d6efd;">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-muted small fw-semibold">Expedições (Dia)</span>
            <div class="stat-icon bg-primary-subtle text-primary" style="width: 36px; height: 36px; font-size: 1.1rem;">
              <i class="bi bi-calendar-event"></i>
            </div>
          </div>
          <h3 class="fw-bold mb-0 text-dark"><%= indicadores.expHoje %></h3>
          <span class="text-muted" style="font-size: 0.75rem;">NFs registradas hoje</span>
        </div>
      </a>
    </div>

    <!-- 2. Em Preparação -->
    <div class="col-6 col-md-4 col-xl-2">
      <a href="/expedicoes?status_id=2" class="text-decoration-none">
        <div class="card card-janlux card-stat p-3 h-100" style="border-left-color: #17a2b8;">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-muted small fw-semibold">Em Preparação</span>
            <div class="stat-icon text-info bg-info-subtle" style="width: 36px; height: 36px; font-size: 1.1rem;">
              <i class="bi bi-gear-wide-connected"></i>
            </div>
          </div>
          <h3 class="fw-bold mb-0 text-dark"><%= indicadores.emPreparacao %></h3>
          <span class="text-muted" style="font-size: 0.75rem;">Sendo embaladas</span>
        </div>
      </a>
    </div>

    <!-- 3. Pronta para Coleta -->
    <div class="col-6 col-md-4 col-xl-2">
      <a href="/expedicoes?status_id=4" class="text-decoration-none">
        <div class="card card-janlux card-stat p-3 h-100" style="border-left-color: #28a745;">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-muted small fw-semibold">Prontas p/ Coleta</span>
            <div class="stat-icon text-success bg-success-subtle" style="width: 36px; height: 36px; font-size: 1.1rem;">
              <i class="bi bi-check-circle"></i>
            </div>
          </div>
          <h3 class="fw-bold mb-0 text-dark"><%= indicadores.prontasColeta %></h3>
          <span class="text-muted" style="font-size: 0.75rem;">Caixas concluídas</span>
        </div>
      </a>
    </div>

    <!-- 4. Coletas Realizadas -->
    <div class="col-6 col-md-4 col-xl-2">
      <a href="/coletas" class="text-decoration-none">
        <div class="card card-janlux card-stat p-3 h-100" style="border-left-color: #007bff;">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-muted small fw-semibold">Coletas Concluídas</span>
            <div class="stat-icon text-primary bg-primary-subtle" style="width: 36px; height: 36px; font-size: 1.1rem;">
              <i class="bi bi-truck"></i>
            </div>
          </div>
          <h3 class="fw-bold mb-0 text-dark"><%= indicadores.totalColetas %></h3>
          <span class="text-muted" style="font-size: 0.75rem;"><%= indicadores.coletasConcluidasHoje %> retiradas hoje</span>
        </div>
      </a>
    </div>

    <!-- 5. Volumes Expedidos Hoje -->
    <div class="col-6 col-md-4 col-xl-2">
      <a href="/relatorios/executar?tipo=4" class="text-decoration-none">
        <div class="card card-janlux card-stat p-3 h-100" style="border-left-color: #6f42c1;">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-muted small fw-semibold">Volumes Físicos</span>
            <div class="stat-icon text-purple bg-purple-subtle" style="width: 36px; height: 36px; font-size: 1.1rem; color: #6f42c1; background-color: #f3e8ff;">
              <i class="bi bi-boxes"></i>
            </div>
          </div>
          <h3 class="fw-bold mb-0 text-dark"><%= indicadores.volumesHoje %></h3>
          <span class="text-muted" style="font-size: 0.75rem;">Volumes do dia</span>
        </div>
      </a>
    </div>

    <!-- 6. Comprovantes Pendentes -->
    <div class="col-6 col-md-4 col-xl-2">
      <a href="/coletas?status_comprovante=emitido" class="text-decoration-none">
        <div class="card card-janlux card-stat p-3 h-100" style="border-left-color: #fd7e14;">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-muted small fw-semibold">Comprovantes</span>
            <div class="stat-icon text-warning bg-warning-subtle" style="width: 36px; height: 36px; font-size: 1.1rem;">
              <i class="bi bi-file-earmark-text"></i>
            </div>
          </div>
          <h3 class="fw-bold mb-0 text-dark"><%= indicadores.comprovantesPendentes %></h3>
          <span class="text-muted" style="font-size: 0.75rem;">Aguardando assinatura</span>
        </div>
      </a>
    </div>
  </div>

  <!-- Atalhos Rápidos da Rotina -->
  <div class="card card-janlux p-3 mb-4">
    <div class="d-flex align-items-center justify-content-between mb-2">
      <span class="fw-bold small text-uppercase text-muted"><i class="bi bi-lightning-charge me-1"></i> Ações e Atalhos Rápidos</span>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/expedicoes/nova" class="btn btn-outline-primary btn-sm"><i class="bi bi-plus-lg me-1"></i> Nova Expedição</a>
      <a href="/expedicoes?conferencia=0" class="btn btn-outline-warning btn-sm"><i class="bi bi-clipboard-check me-1"></i> Registrar Conferência</a>
      <a href="/coletas/nova" class="btn btn-outline-success btn-sm"><i class="bi bi-truck me-1"></i> Registrar Coleta</a>
      <a href="/coletas" class="btn btn-outline-info btn-sm"><i class="bi bi-file-earmark-pdf me-1"></i> Gerar Comprovante</a>
      <a href="/expedicoes" class="btn btn-outline-secondary btn-sm"><i class="bi bi-search me-1"></i> Consultar Nota Fiscal</a>
      <a href="/almoxarifado" class="btn btn-outline-dark btn-sm"><i class="bi bi-box-seam me-1"></i> Movimentar Embalagens</a>
      <a href="/relatorios/executar?tipo=9" class="btn btn-outline-secondary btn-sm"><i class="bi bi-archive me-1"></i> Consultar Estoque</a>
      <a href="/relatorios" class="btn btn-outline-primary btn-sm"><i class="bi bi-graph-up me-1"></i> Emitir Relatórios</a>
    </div>
  </div>

  <!-- Duas Colunas: Últimas Expedições e Últimas Coletas -->
  <div class="row g-4">
    <!-- Coluna 1: Últimas Expedições -->
    <div class="col-lg-7">
      <div class="card card-janlux h-100">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h6 class="fw-bold mb-0 text-navy"><i class="bi bi-box-seam me-2"></i> Últimas Expedições Cadastradas</h6>
          <a href="/expedicoes" class="small text-decoration-none">Ver todas &rarr;</a>
        </div>
        <div class="table-responsive">
          <table class="table table-janlux mb-0">
            <thead>
              <tr>
                <th>Data</th>
                <th>NF</th>
                <th>Cliente</th>
                <th>Transportadora</th>
                <th>Volumes</th>
                <th>Status</th>
                <th class="text-end">Ação</th>
              </tr>
            </thead>
            <tbody>
              <% if (ultimasExpedicoes.length === 0) { %>
                <tr><td colspan="7" class="text-center text-muted py-4">Nenhuma expedição registrada.</td></tr>
              <% } else { %>
                <% ultimasExpedicoes.forEach(exp => { %>
                  <tr>
                    <td><%= formatDateBR(exp.data_disponibilizacao || exp.data_emissao) %></td>
                    <td class="fw-bold text-navy"><%= exp.numero_nf %></td>
                    <td>
                      <div class="text-truncate" style="max-width: 170px;" title="<%= exp.cliente_nome %>">
                        <%= exp.cliente_nome %>
                      </div>
                    </td>
                    <td>
                      <div class="text-truncate" style="max-width: 130px;" title="<%= exp.transportadora_nome %>">
                        <%= exp.transportadora_nome || 'N/A' %>
                      </div>
                    </td>
                    <td><span class="badge bg-light text-dark border"><%= exp.total_volumes_fisicos || 1 %> vol</span></td>
                    <td>
                      <span class="badge badge-status" style="background-color: <%= exp.status_cor %>; color: #fff;">
                        <%= exp.status_nome %>
                      </span>
                    </td>
                    <td class="text-end">
                      <a href="/expedicoes/<%= exp.id %>" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Ver detalhes">
                        <i class="bi bi-eye"></i>
                      </a>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Coluna 2: Últimas Coletas e Retiradas -->
    <div class="col-lg-5">
      <div class="card card-janlux h-100">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h6 class="fw-bold mb-0 text-navy"><i class="bi bi-truck me-2"></i> Coletas Recentes</h6>
          <a href="/coletas" class="small text-decoration-none">Ver todas &rarr;</a>
        </div>
        <div class="table-responsive">
          <table class="table table-janlux mb-0">
            <thead>
              <tr>
                <th>Nº Coleta</th>
                <th>Data/Hora</th>
                <th>Transportadora</th>
                <th>NFs / Vols</th>
                <th>Comprovante</th>
                <th class="text-end">Ação</th>
              </tr>
            </thead>
            <tbody>
              <% if (ultimasColetas.length === 0) { %>
                <tr><td colspan="6" class="text-center text-muted py-4">Nenhuma coleta registrada até o momento.</td></tr>
              <% } else { %>
                <% ultimasColetas.forEach(col => { %>
                  <tr>
                    <td class="fw-bold text-primary"><%= col.numero %></td>
                    <td><%= formatDateBR(col.data_retirada) %><br><span class="text-muted small"><%= col.hora_retirada %></span></td>
                    <td>
                      <div class="text-truncate" style="max-width: 120px;" title="<%= col.transportadora_nome || col.transportadora_cadastrada %>">
                        <%= col.transportadora_nome || col.transportadora_cadastrada || 'N/A' %>
                      </div>
                    </td>
                    <td>
                      <span class="small fw-semibold"><%= col.total_nfs %> NF(s)</span><br>
                      <span class="text-muted small"><%= col.total_volumes %> vol(s)</span>
                    </td>
                    <td>
                      <% if (col.comprovante_status === 'assinado' || col.comprovante_status === 'arquivado') { %>
                        <span class="badge bg-success small"><i class="bi bi-check-all"></i> <%= col.comprovante_status.toUpperCase() %></span>
                      <% } else if (col.comprovante_status === 'emitido') { %>
                        <span class="badge bg-warning text-dark small"><i class="bi bi-clock"></i> AGUARD. ASSINATURA</span>
                      <% } else { %>
                        <span class="badge bg-secondary small">PENDENTE</span>
                      <% } %>
                    </td>
                    <td class="text-end">
                      <a href="/coletas/<%= col.id %>" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Ver detalhes">
                        <i class="bi bi-eye"></i>
                      </a>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
