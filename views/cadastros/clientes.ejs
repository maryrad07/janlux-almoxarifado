<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container-fluid">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">
    <div>
      <h4 class="fw-bold mb-1 text-navy">Cadastro de Clientes</h4>
      <p class="text-muted small mb-0">Centralização de clientes e destinatários para agilizar o lançamento de expedições</p>
    </div>
    <div class="mt-2 mt-md-0">
      <button type="button" class="btn btn-janlux" data-bs-toggle="modal" data-bs-target="#modalCliente" onclick="limparFormCliente()">
        <i class="bi bi-person-plus me-1"></i> Novo Cliente
      </button>
    </div>
  </div>

  <% if (msg) { %>
    <div class="alert alert-success alert-dismissible fade show small" role="alert">
      <i class="bi bi-check-circle me-1"></i> <%= msg %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <% if (err) { %>
    <div class="alert alert-danger alert-dismissible fade show small" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= err %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- Busca -->
  <div class="card card-janlux p-3 mb-3">
    <form action="/cadastros/clientes" method="GET" class="row g-2 align-items-end">
      <div class="col-md-9">
        <label class="form-label small fw-semibold">Pesquisar Cliente</label>
        <div class="input-group input-group-sm">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="text" name="busca" class="form-control" placeholder="Razão Social, CNPJ ou Cidade..." value="<%= busca %>">
        </div>
      </div>
      <div class="col-md-3 d-flex gap-1">
        <button type="submit" class="btn btn-janlux btn-sm w-100"><i class="bi bi-funnel"></i> Filtrar</button>
        <a href="/cadastros/clientes" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg"></i></a>
      </div>
    </form>
  </div>

  <!-- Tabela de Clientes -->
  <div class="card card-janlux">
    <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
      <span class="small fw-semibold text-muted">Exibindo <%= clientes.length %> clientes</span>
    </div>
    <div class="table-responsive">
      <table class="table table-janlux mb-0">
        <thead>
          <tr>
            <th>Cód.</th>
            <th>Razão Social / Nome</th>
            <th>Nome Fantasia</th>
            <th>CNPJ</th>
            <th>Telefone</th>
            <th>Cidade/UF</th>
            <th class="text-end">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if (clientes.length === 0) { %>
            <tr><td colspan="7" class="text-center text-muted py-5">Nenhum cliente cadastrado.</td></tr>
          <% } else { %>
            <% clientes.forEach(cli => { %>
              <tr>
                <td><small class="text-muted"><%= cli.codigo || ('CLI-' + cli.id) %></small></td>
                <td class="fw-bold text-navy"><%= cli.razao_social %></td>
                <td><%= cli.nome_fantasia || '-' %></td>
                <td><%= cli.cnpj || '-' %></td>
                <td><%= cli.telefone || '-' %></td>
                <td><%= cli.cidade ? cli.cidade + (cli.estado ? '/' + cli.estado : '') : '-' %></td>
                <td class="text-end">
                  <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" onclick='editarCliente(<%= JSON.stringify(cli) %>)' title="Editar">
                    <i class="bi bi-pencil"></i>
                  </button>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<!-- Modal Cliente -->
<div class="modal fade" id="modalCliente" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form action="/cadastros/clientes/salvar" method="POST">
        <input type="hidden" name="id" id="cliId">
        <div class="modal-header bg-light">
          <h5 class="modal-title fw-bold text-navy" id="cliModalTitle">Cadastrar Cliente</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <div class="row g-3">
            <div class="col-md-3">
              <label class="form-label small fw-semibold">Código Interno</label>
              <input type="text" name="codigo" id="cliCodigo" class="form-control" placeholder="ex: CLI-01">
            </div>
            <div class="col-md-9">
              <label class="form-label small fw-semibold">Razão Social / Nome <span class="text-danger">*</span></label>
              <input type="text" name="razao_social" id="cliRazao" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Nome Fantasia</label>
              <input type="text" name="nome_fantasia" id="cliFantasia" class="form-control">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">CNPJ</label>
              <input type="text" name="cnpj" id="cliCnpj" class="form-control" placeholder="00.000.000/0000-00">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Telefone</label>
              <input type="text" name="telefone" id="cliTelefone" class="form-control">
            </div>
            <div class="col-md-5">
              <label class="form-label small fw-semibold">Cidade</label>
              <input type="text" name="cidade" id="cliCidade" class="form-control">
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-semibold">Estado (UF)</label>
              <input type="text" name="estado" id="cliEstado" class="form-control text-uppercase" maxlength="2">
            </div>
            <div class="col-12">
              <label class="form-label small fw-semibold">Observações</label>
              <textarea name="observacoes" id="cliObs" class="form-control form-control-sm" rows="2"></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-janlux btn-sm">Salvar Cliente</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function limparFormCliente() {
    document.getElementById('cliId').value = '';
    document.getElementById('cliCodigo').value = '';
    document.getElementById('cliRazao').value = '';
    document.getElementById('cliFantasia').value = '';
    document.getElementById('cliCnpj').value = '';
    document.getElementById('cliTelefone').value = '';
    document.getElementById('cliCidade').value = '';
    document.getElementById('cliEstado').value = '';
    document.getElementById('cliObs').value = '';
    document.getElementById('cliModalTitle').innerText = 'Cadastrar Novo Cliente';
  }

  function editarCliente(cli) {
    document.getElementById('cliId').value = cli.id;
    document.getElementById('cliCodigo').value = cli.codigo || '';
    document.getElementById('cliRazao').value = cli.razao_social || '';
    document.getElementById('cliFantasia').value = cli.nome_fantasia || '';
    document.getElementById('cliCnpj').value = cli.cnpj || '';
    document.getElementById('cliTelefone').value = cli.telefone || '';
    document.getElementById('cliCidade').value = cli.cidade || '';
    document.getElementById('cliEstado').value = cli.estado || '';
    document.getElementById('cliObs').value = cli.observacoes || '';
    document.getElementById('cliModalTitle').innerText = 'Editar Cliente';
    new bootstrap.Modal(document.getElementById('modalCliente')).show();
  }
</script>

<%- include('../partials/footer') %>
