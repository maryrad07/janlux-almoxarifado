<%- include('partials/header') %>

<div class="d-flex align-items-center justify-content-center" style="min-height: 100vh; background: linear-gradient(135deg, #0f2b46 0%, #1e4b75 100%);">
  <div class="card shadow-lg p-4 p-md-5" style="max-width: 480px; width: 100%; border-radius: 14px; border: none;">
    <div class="text-center mb-4">
      <div class="mb-3">
        <img src="/public/img/logo.jpg" alt="JANLUX" style="max-height: 70px; max-width: 100%; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
      </div>
      <h4 class="fw-bold mb-1" style="color: #0f2b46;">JANLUX ELÉTRICOS</h4>
      <p class="text-muted small">Controle de Almoxarifado, Embalagens e Expedição</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show small py-2" role="alert">
        <i class="bi bi-exclamation-circle me-1"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <% if (typeof msg !== 'undefined' && msg) { %>
      <div class="alert alert-success alert-dismissible fade show small py-2" role="alert">
        <i class="bi bi-check-circle me-1"></i> <%= msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <form action="/login" method="POST" id="formLogin">
      <div class="mb-3">
        <label class="form-label small fw-semibold">Usuário / Login</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-person"></i></span>
          <input type="text" name="login" id="loginInput" class="form-control" 
                 placeholder="ex: admin" required autofocus autocomplete="username">
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label small fw-semibold">Senha</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-lock"></i></span>
          <input type="password" name="senha" id="senhaInput" class="form-control" 
                 placeholder="••••••••" required autocomplete="current-password" id="senhaInput">
          <button class="btn btn-outline-secondary" type="button" id="btnVerSenha" title="Mostrar/Ocultar senha">
            <i class="bi bi-eye" id="iconSenha"></i>
          </button>
        </div>
      </div>

      <div class="d-flex align-items-center mb-4">
        <input class="form-check-input me-2" type="checkbox" id="lembrarLogin" style="cursor:pointer;">
        <label class="form-check-label small text-muted" for="lembrarLogin" style="cursor:pointer;">
          Lembrar meu usuário neste computador
        </label>
      </div>

      <button type="submit" class="btn btn-janlux w-100 py-2 fw-semibold">
        <i class="bi bi-box-arrow-in-right me-1"></i> Acessar Sistema
      </button>
    </form>

    <hr class="my-4">

    <!-- Acesso Rápido por Usuário -->
    <div class="text-center">
      <span class="small text-muted d-block mb-2"><i class="bi bi-lightning-fill text-warning me-1"></i>Acesso Rápido:</span>
      <div class="d-flex flex-wrap gap-1 justify-content-center" id="usuariosRapidos">
        <button type="button" class="btn btn-sm btn-outline-primary" onclick="setLogin('admin', 'admin123')">
          <i class="bi bi-shield-lock"></i> Admin
        </button>
        <button type="button" class="btn btn-sm btn-outline-success" onclick="setLogin('sandra', 'sandra123')">
          <i class="bi bi-person-check"></i> Sandra
        </button>
        <button type="button" class="btn btn-sm btn-outline-success" onclick="setLogin('ivan', 'ivan123')">
          <i class="bi bi-person-check"></i> Ivan
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setLogin('consulta', 'consulta123')">
          <i class="bi bi-eye"></i> Consulta
        </button>
      </div>
    </div>

    <p class="text-center text-muted small mt-4 mb-0">
      <i class="bi bi-info-circle me-1"></i>
      Em caso de problemas de acesso, contate o administrador do sistema.
    </p>
  </div>
</div>

<script>
  // Mostrar/ocultar senha
  document.getElementById('btnVerSenha').addEventListener('click', function() {
    const inp = document.getElementById('senhaInput');
    const ico = document.getElementById('iconSenha');
    if (inp.type === 'password') {
      inp.type = 'text';
      ico.className = 'bi bi-eye-slash';
    } else {
      inp.type = 'password';
      ico.className = 'bi bi-eye';
    }
  });

  // Preenche login e envia o formulário automaticamente
  function setLogin(user, pass) {
    document.getElementById('loginInput').value = user;
    document.getElementById('senhaInput').value = pass;
    document.getElementById('formLogin').submit();
  }

  // Lembrar usuário no localStorage
  const loginInput = document.getElementById('loginInput');
  const chkLembrar = document.getElementById('lembrarLogin');
  const savedLogin = localStorage.getItem('janlux_login');

  if (savedLogin) {
    loginInput.value = savedLogin;
    chkLembrar.checked = true;
    // Move foco para a senha
    document.getElementById('senhaInput').focus();
  }

  document.getElementById('formLogin').addEventListener('submit', function() {
    if (chkLembrar.checked) {
      localStorage.setItem('janlux_login', loginInput.value);
    } else {
      localStorage.removeItem('janlux_login');
    }
  });
</script>

<%- include('partials/footer') %>
